[Unit]
Description=Claude Code Cache Fix Proxy
After=network.target
{{REQUIRES_LINE}}

[Service]
Type=simple
ExecStart={{NODE}} {{LAUNCHER_PATH}} run-service
# Reload = SIGUSR2: a new run-service adopts the port with no gap. A stop must
# end only the holder (KillMode=process), leaving a standby carrying the port.
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=process
KillSignal=SIGTERM
# Not "always": a handover or an already-held start exits 0.
Restart=on-failure
RestartSec=0
Environment=CACHE_FIX_PROXY_PORT={{PORT}}
{{PROXY_ENV_LINES}}
{{UPSTREAM_LINE}}
{{CA_FILE_LINE}}
{{REJECT_UNAUTHORIZED_LINE}}
{{DEBUG_LINE}}
{{HOT_RELOAD_LINE}}
{{FORWARD_PROXY_LINE}}
WorkingDirectory={{WORKING_DIR}}

[Install]
WantedBy=default.target
